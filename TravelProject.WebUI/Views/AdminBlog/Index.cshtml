@using TravelProject.Dto.BlogDtos
@model List<ResultBlogDto>

@{
    ViewBag.Title = "Bloglar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="w3-container">

    <div class="w3-bar w3-margin-bottom">

        <h2 class="w3-bar-item">
            Blog Yönetimi
        </h2>

        <a asp-controller="AdminBlog"
           asp-action="Create"
           class="w3-button w3-green w3-right w3-margin-top">

            Yeni Blog Ekle

        </a>

    </div>


    @if (Model != null && Model.Any())
    {
        <div class="w3-responsive">

            <table class="w3-table-all w3-hoverable">

                <thead>

                    <tr class="w3-teal">

                        <th>Id</th>
                        <th>Başlık</th>
                        <th>Görsel</th>
                        <th>Tarih</th>
                        <th>İşlemler</th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.BlogId
                            </td>

                            <td>
                                @item.Title
                            </td>

                            <td>

                                <img src="@item.ImageUrl"
                                     alt="@item.Title"
                                     style="width:100px; height:65px; object-fit:cover;" />

                            </td>

                            <td>
                                @item.CreatedDate.ToString("dd.MM.yyyy")
                            </td>

                            <td>

                                <a asp-controller="AdminBlog"
                                   asp-action="Update"
                                   asp-route-id="@item.BlogId"
                                   class="w3-button w3-blue w3-small">

                                    Güncelle

                                </a>

                                <a asp-controller="AdminBlog"
                                   asp-action="Delete"
                                   asp-route-id="@item.BlogId"
                                   class="w3-button w3-red w3-small"
                                   onclick="return confirm('Bu blogu silmek istediğinize emin misiniz?');">

                                    Sil

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="w3-panel w3-pale-yellow">

            <p>
                Henüz blog bulunmuyor.
            </p>

        </div>
    }

</div>