@using TravelProject.Dto.BlogDtos
@model UpdateBlogDto

@{
    ViewBag.Title = "Blog Güncelle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="w3-container">

    <h2>Blog Güncelle</h2>

    <form asp-controller="AdminBlog"
          asp-action="Update"
          method="post"
          class="w3-container w3-card-4 w3-light-grey"
          style="padding:25px; margin-top:20px;">

        <input type="hidden"
               asp-for="BlogId" />

        <input type="hidden"
               asp-for="CreatedDate" />

        <p>
            <label>Başlık</label>

            <input asp-for="Title"
                   class="w3-input w3-border"
                   type="text" />
        </p>

        <p>
            <label>Açıklama</label>

            <textarea asp-for="Description"
                      class="w3-input w3-border"
                      rows="6"></textarea>
        </p>

        <p>
            <label>Görsel Yolu</label>

            <input asp-for="ImageUrl"
                   class="w3-input w3-border"
                   type="text" />
        </p>

        <p>

            <button type="submit"
                    class="w3-button w3-blue">

                Güncelle

            </button>

            <a asp-controller="AdminBlog"
               asp-action="Index"
               class="w3-button w3-grey">

                Listeye Dön

            </a>

        </p>

    </form>

</div>