@using TravelProject.Dto.AboutUsDtos
@model ResultAboutUsDto

@{
    ViewData["Title"] = "Hakkımızda";
}

<div class="content">
    <div class="wrap">

        <div class="about">

            @if (Model != null)
            {
                <h3>@Model.Title</h3>

                <img src="@Model.ImageUrl"
                     alt="@Model.Title" />

                <p>@Model.Description</p>
            }
            else
            {
                <h3>Hakkımızda</h3>
                <p>Henüz hakkımızda bilgisi eklenmemiş.</p>
            }

        </div>

    </div>
</div>