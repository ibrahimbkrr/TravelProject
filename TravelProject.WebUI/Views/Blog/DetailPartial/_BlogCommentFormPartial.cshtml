@using TravelProject.WebUI.Models
@model BlogDetailViewModel

<div class="content-form">

    <h3>Yorum Yap</h3>

    <form asp-controller="Blog"
          asp-action="AddComment"
          method="post">

        <input type="hidden"
               asp-for="Blog.BlogId" />

        <input asp-for="NewComment.UserName"
               type="text"
               placeholder="Ad Soyad"
               required />

        <textarea asp-for="NewComment.CommentText"
                  placeholder="Yorumunuz"
                  required></textarea>

        <input type="submit"
               value="YORUMU GÖNDER" />

    </form>

</div>