@using TravelProject.Dto.AdminDtos
@model LoginAdminDto

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="tr">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>TravelProject Admin Giriş</title>

    <link href="~/webLogin/css/style.css"
          rel="stylesheet"
          type="text/css"
          media="all"
          asp-append-version="true" />

</head>

<body>

    <div class="padding-all">

        <div class="header">

            <h1>
                TravelProject Admin
            </h1>

        </div>


        <div class="design-w3l">

            <div class="mail-form-agile">

                <form asp-controller="Login"
                      asp-action="Index"
                      method="post">

                    <input type="hidden"
                           name="returnUrl"
                           value="@ViewBag.ReturnUrl" />


                    <input asp-for="UserName"
                           type="text"
                           placeholder="Kullanıcı Adı"
                           required />


                    <input asp-for="Password"
                           type="password"
                           class="padding"
                           placeholder="Şifre"
                           required />


                    <input type="submit"
                           value="Giriş Yap" />

                </form>


                @if (ViewBag.Error != null)
                {
                    <div style="
                                color:white;
                                background:#c0392b;
                                padding:10px;
                                margin-top:15px;
                                text-align:center;">

                        @ViewBag.Error

                    </div>
                }

            </div>

            <div class="clear"></div>

        </div>

    </div>

</body>

</html>