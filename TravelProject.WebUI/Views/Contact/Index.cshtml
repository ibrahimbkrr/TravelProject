@using TravelProject.Dto.ContactDtos
@model CreateContactDto

@{
    ViewData["Title"] = "İletişim";
}

<div class="contact">
    <div class="wrap">

        <div class="contact-top">
            <h3>İletişim</h3>
            <p>
                Görüş, öneri ve sorularınız için aşağıdaki formu kullanarak
                bizimle iletişime geçebilirsiniz.
            </p>
        </div>

        @if (ViewBag.Success == true)
        {
            <div class="contact-success-message">
                Mesajınız başarıyla gönderildi.
            </div>
        }

        <form asp-controller="Contact"
              asp-action="Index"
              method="post"
              class="cmxform"
              id="contactForm">

            <div class="form">

                <div>
                    <input asp-for="NameSurname"
                           type="text"
                           class="textbox"
                           placeholder="Ad Soyad" />
                </div>

                <div>
                    <input asp-for="Email"
                           type="email"
                           class="textbox"
                           placeholder="E-posta" />
                </div>

                <div>
                    <input asp-for="Subject"
                           type="text"
                           class="textbox"
                           placeholder="Konu" />
                </div>

            </div>

            <div class="form1">

                <div>
                    <textarea asp-for="Message"
                              placeholder="Mesajınız"></textarea>
                </div>

                <div>
                    <button type="submit" class="read">
                        Gönder
                    </button>
                </div>

            </div>

            <div class="clear"></div>

        </form>


        <div class="contact-bottom">

            <div class="contact-left">

                <div class="contact-add">
                    <h3>İletişim Bilgileri</h3>

                    <p>
                        Seyahat önerileri, gezi içerikleri veya diğer konular
                        hakkında bizimle iletişime geçebilirsiniz.
                    </p>

                    <p>Telefon: +90 000 000 00 00</p>

                    <p>
                        Email:
                        <a href="mailto:info@easytrip.com">
                            info@easytrip.com
                        </a>
                    </p>
                </div>

            </div>


            <div class="contact-map">

                <iframe width="580"
                        height="250"
                        frameborder="0"
                        scrolling="no"
                        marginheight="0"
                        marginwidth="0"
                        src="https://www.google.com/maps?q=Elazig&output=embed">
                </iframe>

            </div>

            <div class="clear"></div>

        </div>

        <div class="clear"></div>

    </div>
</div>